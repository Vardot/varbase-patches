diff --git a/password_policy.install b/password_policy.install
index 252a9ce00690de162ae900d193ad7bc0edc6ed5d..a891b7267b22133b51907ed8180a17607c03e28c 100644
--- a/password_policy.install
+++ b/password_policy.install
@@ -8,6 +8,8 @@
 use Drupal\Core\Entity\Sql\SqlContentEntityStorage;
 use Drupal\Core\Language\LanguageInterface;
 use Drupal\datetime\Plugin\Field\FieldType\DateTimeItemInterface;
+use Drupal\field\Entity\FieldConfig;
+use Drupal\field\Entity\FieldStorageConfig;
 
 /**
  * Implements hook_install().
@@ -16,6 +18,74 @@ function password_policy_install() {
   // Give precedence to modules like prlp or simple_pass_reset.
   module_set_weight('password_policy', 10);
 
+  // Programmatically create field storages and instances if they don't exist.
+  // This ensures fields are created even when the module is installed via a
+  // Drupal Recipe (which sets isSyncing(TRUE), causing config entity creation
+  // from config/install/ to be skipped during module installation).
+  $field_storages = [
+    'field_last_password_reset' => [
+      'type' => 'datetime',
+      'settings' => ['datetime_type' => 'datetime'],
+    ],
+    'field_password_expiration' => [
+      'type' => 'boolean',
+      'settings' => [],
+    ],
+    'field_pending_expire_sent' => [
+      'type' => 'integer',
+      'settings' => [],
+    ],
+  ];
+
+  foreach ($field_storages as $field_name => $definition) {
+    if (!FieldStorageConfig::loadByName('user', $field_name)) {
+      FieldStorageConfig::create([
+        'field_name' => $field_name,
+        'entity_type' => 'user',
+        'type' => $definition['type'],
+        'settings' => $definition['settings'],
+        'locked' => TRUE,
+        'cardinality' => 1,
+      ])->save();
+    }
+  }
+
+  $field_instances = [
+    'field_last_password_reset' => [
+      'label' => 'Last Password Reset',
+      'required' => FALSE,
+      'default_value' => [['default_date_type' => 'now', 'default_date' => 'now']],
+      'settings' => [],
+    ],
+    'field_password_expiration' => [
+      'label' => 'Password Expiration',
+      'description' => 'Control whether the user must reset their password. If the password has expired, this field is automatically checked after the execution of Cron.',
+      'required' => FALSE,
+      'default_value' => [['value' => 0]],
+      'settings' => [
+        'on_label' => 'Expired Password',
+        'off_label' => 'Non-expired Password',
+      ],
+    ],
+    'field_pending_expire_sent' => [
+      'label' => 'Pending Expiration Mail Count',
+      'description' => 'Whether an email notifying of a pending password expiration has been sent',
+      'required' => FALSE,
+      'default_value' => [['value' => 0]],
+      'settings' => ['min' => 0, 'max' => NULL, 'prefix' => '', 'suffix' => ''],
+    ],
+  ];
+
+  foreach ($field_instances as $field_name => $definition) {
+    if (!FieldConfig::loadByName('user', 'user', $field_name)) {
+      FieldConfig::create([
+        'field_name' => $field_name,
+        'entity_type' => 'user',
+        'bundle' => 'user',
+      ] + $definition)->save();
+    }
+  }
+
   // Set user password reset timestamp to now.
   $timestamp = \Drupal::service("date.formatter")->format(\Drupal::time()->getRequestTime(), "custom", DateTimeItemInterface::DATETIME_STORAGE_FORMAT, DateTimeItemInterface::STORAGE_TIMEZONE);
   \Drupal::state()->set('password_policy.install_time', $timestamp);
