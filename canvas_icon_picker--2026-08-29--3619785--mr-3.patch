@@ -122,6 +122,23 @@ public function testElementExposesAllowedIdsToJs(): void {
     self::assertStringContainsString('data-canvas-icon-picker-allowed-ids="star,heart"', $html);
   }
 
+  /**
+   * Tests that a prop with no allowed ids exposes an empty allow list.
+   *
+   * The JS keys off this attribute: with no ids to match against it stores the
+   * bare id, because the prop holds bare ids and would reject "pack:id".
+   */
+  public function testElementExposesAnEmptyAllowListWhenUnscoped(): void {
+    $element = [
+      '#type' => 'canvas_icon_picker',
+      '#name' => 'icon',
+      '#allowed_packs' => ['test_pack'],
+    ];
+    $html = (string) $this->container->get('renderer')->renderInIsolation($element);
+    self::assertStringContainsString('data-canvas-icon-picker-allowed-ids=""', $html);
+    self::assertStringNotContainsString('&amp;ids=', $html, 'The endpoints stay unfiltered.');
+  }
+
   /**
    * Tests that a bare id on a pack-scoped prop resolves in that pack first.
