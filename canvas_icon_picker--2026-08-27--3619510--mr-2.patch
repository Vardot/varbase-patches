diff --git a/src/Plugin/Field/FieldWidget/CanvasIconPickerWidget.php b/src/Plugin/Field/FieldWidget/CanvasIconPickerWidget.php
--- a/src/Plugin/Field/FieldWidget/CanvasIconPickerWidget.php
+++ b/src/Plugin/Field/FieldWidget/CanvasIconPickerWidget.php
@@ -16,7 +16,7 @@ use Drupal\Core\StringTranslation\TranslatableMarkup;
 #[FieldWidget(
   id: 'canvas_icon_picker',
   label: new TranslatableMarkup('Icon picker'),
-  field_types: ['string'],
+  field_types: ['string', 'list_string'],
 )]
 final class CanvasIconPickerWidget extends WidgetBase {
 
@@ -28,8 +28,48 @@ final class CanvasIconPickerWidget extends WidgetBase {
       '#type' => 'canvas_icon_picker',
       '#default_value' => $items[$delta]->value ?? '',
       '#allowed_packs' => $this->getFieldSetting('allowed_icon_pack') ?? [],
+      '#allowed_icon_ids' => $this->allowedIconIds($items),
     ];
     return $element;
   }
 
+  /**
+   * Icon ids this field is limited to; empty means the whole pack.
+   *
+   * A prop that declares `enum` becomes a list field whose allowed values are
+   * those enum members, so the constraint is already on the field. Read it
+   * from there instead of storing a second copy of it.
+   */
+  private function allowedIconIds(FieldItemListInterface $items): array {
+    if ($this->fieldDefinition->getType() !== 'list_string') {
+      return [];
+    }
+    $storage_definition = $this->fieldDefinition->getFieldStorageDefinition();
+    $callback = $storage_definition->getSetting('allowed_values_function');
+    if (!is_callable($callback)) {
+      return [];
+    }
+    $cacheable = FALSE;
+    $allowed = $callback($storage_definition, $items->getEntity(), $cacheable);
+    return array_map('strval', array_keys(is_array($allowed) ? $allowed : []));
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function massageFormValues(array $values, array $form, FormStateInterface $form_state): array {
+    if ($this->fieldDefinition->getType() !== 'list_string') {
+      return $values;
+    }
+    // The picker writes "pack:icon_id". A list field stores one of its allowed
+    // values, which are the bare ids the prop's `enum` declares.
+    foreach ($values as $delta => $value) {
+      $raw = (string) ($value['value'] ?? '');
+      if ($raw !== '' && str_contains($raw, ':')) {
+        $values[$delta]['value'] = substr($raw, strpos($raw, ':') + 1);
+      }
+    }
+    return $values;
+  }
+
 }
