index 0000000000000000000000000000000000000000..73a6dee7a7e4484ce1338be9398f9e52a7fdd25c
--- /dev/null
+++ b/src/Hook/TrashHandler/TaxonomyTermTrashHandler.php
@@ -0,0 +1,66 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\trash\Hook\TrashHandler;
+
+use Drupal\Core\Database\Query\AlterableInterface;
+use Drupal\Core\Entity\EntityInterface;
+use Drupal\Core\Hook\Attribute\Hook;
+use Drupal\taxonomy\Entity\Term;
+use Drupal\trash\Handler\DefaultTrashHandler;
+
+/**
+ * Provides a trash handler for the 'taxonomy_term' entity type.
+ */
+class TaxonomyTermTrashHandler extends DefaultTrashHandler {
+
+  /**
+   * Implements hook_query_alter().
+   *
+   * This prevents deleted taxonomy terms from appearing in taxonomy tree
+   * operations and overview pages by checking for relevant tags.
+   */
+  #[Hook('query_alter')]
+  public function queryAlter(AlterableInterface $query): void {
+    // Only act on queries with taxonomy term access related tags.
+    if ($query->hasTag('taxonomy_term_access') || $query->hasTag('term_access')) {
+      // Get the trash manager service directly since dependency injection
+      // doesn't work with hook handlers.
+      // @phpstan-ignore-next-line
+      $trashManager = \Drupal::service('trash.manager');
+
+      // Only alter queries if trash context allows it.
+      if (!$trashManager->isEntityTypeEnabled('taxonomy_term')) {
+        return;
+      }
+
+      // Add condition to exclude deleted terms.
+      /** @var \Drupal\Core\Database\Query\SelectInterface $query */
+      $tables = $query->getTables();
+
+      // Look for taxonomy term data tables.
+      foreach ($tables as $alias => $table_info) {
+        if (isset($table_info['table']) && $table_info['table'] === 'taxonomy_term_field_data') {
+          // Add condition to exclude trashed terms.
+          if ($query->hasTag('trash')) {
+            continue;
+          }
+          $query->isNull($alias . '.deleted');
+          break;
+        }
+      }
+    }
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function postTrashDelete(EntityInterface $entity): void {
+    // Call Drupal's core Term::postDelete to handle taxonomy-specific cleanup.
+    Term::postDelete($this->entityTypeManager->getStorage('taxonomy_term'), [
+      $entity->id() => $entity,
+    ]);
+  }
+
+}
diff --git a/tests/src/Kernel/TaxonomyTermTrashTest.php b/tests/src/Kernel/TaxonomyTermTrashTest.php
