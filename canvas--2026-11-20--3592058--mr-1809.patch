+  /**
+   * Past revisions of a soft-deleted entity (e.g. by the Trash module) are not checked: the entity does not load, so validating them would crash cron.
+   *
+   * @see https://www.drupal.org/project/canvas/issues/3592058
+   */
+  public function testSoftDeletedEntityPastRevisionsAreSkipped(): void {
+    $live = self::createValidPage('Live page');
+    $live_past_rid = $live->getRevisionId();
+    $live->setNewRevision(TRUE);
+    $live->save();
+
+    $trashed = self::createValidPage('Trashed page');
+    $trashed_id = $trashed->id();
+    $trashed_past_rid = $trashed->getRevisionId();
+    self::assertNotNull($trashed_id);
+    self::assertNotNull($trashed_past_rid);
+    $trashed->setNewRevision(TRUE);
+    $trashed->save();
+    // Soft-delete it like Trash: a new default revision that entity queries
+    // and entity loads skip. Its older revisions still load.
+    $trashed->setNewRevision(TRUE);
+    $trashed->save();
+    $this->softDeletedRevisionIds = [(int) $trashed->getRevisionId()];
+    $page_storage = $this->container->get(EntityTypeManagerInterface::class)->getStorage(Page::ENTITY_TYPE_ID);
+    \assert($page_storage instanceof RevisionableStorageInterface);
+    self::assertNull($page_storage->loadUnchanged($trashed_id));
+    self::assertNotNull($page_storage->loadRevision($trashed_past_rid));
+
+    // Only the live page's past revision is listed and validated.
+    self::assertSame(1, $this->validator->countCheckItems(HealthCheck::ContentPastRevisions));
+    $items = \iterator_to_array($this->validator->runDataChecks([HealthCheck::ContentPastRevisions]), FALSE);
+    self::assertSame([\sprintf('%s:%s:%s', Page::ENTITY_TYPE_ID, $live->id(), $live_past_rid)], \array_column($items, 'key'));
+    self::assertSame([], self::failingFindings($items));
+  }
+
   /**
    * RunCronWindow() bounds work to $limit items, advances across calls, and wraps at the end of the stream (the three pages form the whole content stream).
    */
