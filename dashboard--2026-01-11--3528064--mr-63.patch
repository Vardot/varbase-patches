+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\dashboard\Hook;
+
+use Drupal\Core\Extension\ModuleHandlerInterface;
+use Drupal\Core\Form\FormStateInterface;
+use Drupal\Core\Hook\Attribute\Hook;
+use Drupal\dashboard\Form\DashboardForm;
+use Drupal\dashboard\Form\FormAlter;
+
+/**
+ * Form integration hooks.
+ */
+class FormIntegration {
+
+  public function __construct(
+    protected ModuleHandlerInterface $moduleHandler,
+    protected FormAlter $formAlter,
+  ) {}
+
+  /**
+   * Implements hook_form_FORM_ID_alter() for the dashboard form.
+   */
+  #[Hook('form_dashboard_form_alter')]
+  public function dashboardFormAlter(&$form, FormStateInterface $form_state, $form_id): void {
+    if (!$this->moduleHandler->moduleExists('layout_builder_restrictions')) {
+      return;
+    }
+
+    if (!$form_state->getFormObject() instanceof DashboardForm) {
+      return;
+    }
+
+    $this->formAlter->alterEntityFormAllowedBlockCategories($form, $form_state, $form_id);
+    $this->formAlter->alterEntityForm($form, $form_state, $form_id);
+  }
+
+}
diff --git a/src/LayoutBuilderRestrictionHelperTrait.php b/src/LayoutBuilderRestrictionHelperTrait.php
new file mode 100644
