+++ b/src/LayoutBuilderRestrictionHelperTrait.php
@@ -0,0 +1,26 @@
+<?php
+
+namespace Drupal\dashboard;
+
+use Drupal\dashboard\Plugin\SectionStorage\DashboardSectionStorage;
+use Drupal\layout_builder\SectionStorageInterface;
+
+/**
+ * Simple helper trait.
+ */
+trait LayoutBuilderRestrictionHelperTrait {
+
+  /**
+   * Check if storage is a dashboard storage.
+   *
+   * @param \Drupal\layout_builder\SectionStorageInterface $section
+   *   Section storage.
+   *
+   * @return bool
+   *   Is is a dashboard storage.
+   */
+  public function isDashboardStorage(SectionStorageInterface $section): bool {
+    return $section instanceof DashboardSectionStorage;
+  }
+
+}
diff --git a/src/Plugin/LayoutBuilderRestriction/DashboardsViewModeRestriction.php b/src/Plugin/LayoutBuilderRestriction/DashboardsViewModeRestriction.php
