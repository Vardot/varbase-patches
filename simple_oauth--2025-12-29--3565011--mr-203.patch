diff --git a/simple_oauth.install b/simple_oauth.install
index 9451119aafa31e26a1a28f82e3e9fbeb9eb73967..a38984321efbae500eff4a3f1f07a7e49144a02a 100644
--- a/simple_oauth.install
+++ b/simple_oauth.install
@@ -21,6 +21,15 @@ use Drupal\simple_oauth\Plugin\Oauth2GrantManager;
 function simple_oauth_install() {
   // Create path alias for JWKS endpoint to support /.well-known/jwks.json.
   _simple_oauth_create_jwks_alias();
+
+  // Install the oauth2_scope entity type during installation to prevent
+  // errors when other modules try to reference it during the installation process.
+  $type_manager = \Drupal::entityTypeManager();
+  $type_manager->clearCachedDefinitions();
+  if ($type_manager->hasDefinition('oauth2_scope')) {
+    $entity_type = $type_manager->getDefinition('oauth2_scope');
+    \Drupal::entityDefinitionUpdateManager()->installEntityType($entity_type);
+  }
 }
 
