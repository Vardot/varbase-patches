@@ -102,3 +105,29 @@ function canvas_preprocess_html(array &$variables): void {
     $variables['attributes']['class'][] = 'canvas-page';
   }
 }
+
+/**
+ * Implements hook_entity_access().
+ *
+ * Restricts editing of global Canvas page regions (any page_region other than
+ * the "content" region) to users with the "edit canvas global regions"
+ * permission.
+ */
+function canvas_entity_access(EntityInterface $entity, string $operation, AccountInterface $account): AccessResult {
+  if ($entity->getEntityTypeId() !== 'page_region') {
+    return AccessResult::neutral();
+  }
+  $id = (string) ($entity->id() ?? '');
+  [, $region] = explode('.', $id, 2) + [NULL, NULL];
+  if (!$region || $region === 'content') {
+    return AccessResult::neutral();
+  }
+  if (!in_array($operation, ['update', 'edit', 'delete'], TRUE)) {
+    return AccessResult::neutral();
+  }
+  if ($account->hasPermission('edit canvas global regions')) {
+    return AccessResult::neutral()->cachePerPermissions();
+  }
+  return AccessResult::forbidden('Editing global Canvas regions requires the "edit canvas global regions" permission.')
+    ->cachePerPermissions();
+}
