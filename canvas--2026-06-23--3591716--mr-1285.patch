+++ b/ui/src/components/form/react-hook-form/utils/index.ts
@@ -62,6 +62,12 @@ export const getCurrentValueFromProps = (props: Record<string, any>) => {
   if (props.element?.['#default_value'] !== undefined) {
     return props.element['#default_value'];
   }
+  // For checkboxes, attributes.value is always the on-value (e.g. "1"), not the
+  // checked state. An absent attributes.checked means the checkbox is unchecked,
+  // so return false rather than falling through to attributes.value.
+  if (props.attributes?.type === 'checkbox') {
+    return false;
+  }
   if (props.attributes?.value !== undefined) return props.attributes.value;
 
   return undefined;
