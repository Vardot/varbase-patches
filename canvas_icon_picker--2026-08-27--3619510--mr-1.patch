-      ];
+      $instance_settings['allowed_icon_pack'] = array_values(array_filter($x_canvas_icon, 'is_string'));
+    }
+    // A prop may constrain itself to a curated set of icons with `enum`. Keep
+    // that constraint: offer only those icons in the picker, and store the
+    // value in the form the schema declares, so the picked value still
+    // validates against the enum.
+    $enum = $schema['enum'] ?? NULL;
+    if (is_array($enum) && $enum !== []) {
+      $instance_settings['allowed_icon_ids'] = array_values(array_filter($enum, 'is_string'));
+    }
+    if ($instance_settings !== []) {
+      $storable_prop_shape->fieldInstanceSettings = $instance_settings;
     }
   }
 
diff --git a/src/Plugin/Field/FieldWidget/CanvasIconPickerWidget.php b/src/Plugin/Field/FieldWidget/CanvasIconPickerWidget.php
--- a/src/Plugin/Field/FieldWidget/CanvasIconPickerWidget.php
+++ b/src/Plugin/Field/FieldWidget/CanvasIconPickerWidget.php
@@ -28,8 +28,28 @@ final class CanvasIconPickerWidget extends WidgetBase {
       '#type' => 'canvas_icon_picker',
       '#default_value' => $items[$delta]->value ?? '',
       '#allowed_packs' => $this->getFieldSetting('allowed_icon_pack') ?? [],
+      '#allowed_icon_ids' => $this->getFieldSetting('allowed_icon_ids') ?? [],
     ];
     return $element;
   }
 
+  /**
+   * {@inheritdoc}
+   */
+  public function massageFormValues(array $values, array $form, FormStateInterface $form_state): array {
+    $allowed_ids = $this->getFieldSetting('allowed_icon_ids') ?? [];
+    if ($allowed_ids === []) {
+      return $values;
+    }
+    // The picker writes "pack:icon_id". When the prop declares an `enum` of
+    // bare icon ids, store the bare id so the value still validates.
+    foreach ($values as $delta => $value) {
+      $raw = (string) ($value['value'] ?? '');
+      if ($raw !== '' && str_contains($raw, ':')) {
+        $values[$delta]['value'] = substr($raw, strpos($raw, ':') + 1);
+      }
+    }
+    return $values;
+  }
+
 }
