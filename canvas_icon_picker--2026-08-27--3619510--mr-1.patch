       return;
     }
     $storable_prop_shape->fieldWidget = 'canvas_icon_picker';
+    // The picker widget only supports a plain string field. Without forcing the
+    // field type here, a prop that also declares `enum` keeps the
+    // list_string/options_select shape Canvas already chose, the widget is
+    // silently ignored and the editor renders a select list instead.
+    $storable_prop_shape->fieldTypeProp = new FieldTypePropExpression('string', 'value');
+    $storable_prop_shape->fieldStorageSettings = NULL;
+    $instance_settings = [];
     if ($is_scoped) {
-      $storable_prop_shape->fieldInstanceSettings = [
