diff --git a/src/PluginBase/AiAgentEntityWrapper.php b/src/PluginBase/AiAgentEntityWrapper.php
index 5958104d08af159f779b0728e2b5a2c931e07ba8..dcf5a87dbdbaf057e0f19022c81ff3d82f1f7018 100644
--- a/src/PluginBase/AiAgentEntityWrapper.php
+++ b/src/PluginBase/AiAgentEntityWrapper.php
@@ -1320,6 +1320,13 @@ class AiAgentEntityWrapper implements PluginInterfacesAiAgentInterface, ConfigAi
     ];
     // Add dynamical tokens.
     $tokens = array_merge($tokens, $this->tokens);
+    // An array token value would trigger an "Array to string conversion"
+    // warning in core Token::doReplace(), so coerce it to a string first.
+    foreach ($tokens as $key => $value) {
+      if (is_array($value)) {
+        $tokens[$key] = implode(', ', array_filter($value, 'is_scalar'));
+      }
+    }
     return $this->token->replacePlain($prompt, $tokens);
   }
 
