@@ -0,0 +1,102 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\ai_provider_anthropic\Unit;
+
+use Drupal\Tests\UnitTestCase;
+use Drupal\ai\OperationType\Chat\ChatInput;
+use Drupal\ai\OperationType\Chat\ChatMessage;
+use Drupal\ai_provider_anthropic\Plugin\AiProvider\AnthropicProvider;
+
+/**
+ * Tests that a chat conversation is forced to end with a user message.
+ *
+ * Anthropic rejects a conversation whose last message is not from the user, so
+ * the provider appends a minimal trailing user message when needed. These unit
+ * tests exercise that transformation in isolation, without any network calls.
+ *
+ * @group ai_provider_anthropic
+ *
+ * @coversDefaultClass \Drupal\ai_provider_anthropic\Plugin\AiProvider\AnthropicProvider
+ */
+class AnthropicProviderChatTest extends UnitTestCase {
+
+  /**
+   * Invokes the protected helper under test on a bare provider instance.
+   *
+   * The provider is created without its constructor so no services or HTTP
+   * client are required; the helper only reads and rewrites the chat input.
+   *
+   * @param \Drupal\ai\OperationType\Chat\ChatInput $input
+   *   The chat input to normalize in place.
+   */
+  protected function ensureConversationEndsWithUser(ChatInput $input): void {
+    $reflection = new \ReflectionClass(AnthropicProvider::class);
+    $provider = $reflection->newInstanceWithoutConstructor();
+    $method = $reflection->getMethod('ensureConversationEndsWithUser');
+    $method->setAccessible(TRUE);
+    $method->invoke($provider, $input);
+  }
+
+  /**
+   * Tests that a trailing assistant message gets a user message appended.
+   *
+   * @covers ::ensureConversationEndsWithUser
+   */
+  public function testTrailingAssistantMessageAppendsUser(): void {
+    $input = new ChatInput([
+      new ChatMessage('user', 'Hello.'),
+      new ChatMessage('assistant', 'Hi there.'),
+    ]);
+
+    $this->ensureConversationEndsWithUser($input);
+
+    $messages = $input->getMessages();
+    $this->assertCount(3, $messages);
+    $last = end($messages);
+    $this->assertSame('user', $last->getRole());
+    $this->assertSame('Continue.', $last->getText());
+  }
+
+  /**
+   * Tests that a trailing system message gets a user message appended.
+   *
+   * @covers ::ensureConversationEndsWithUser
+   */
+  public function testTrailingSystemMessageAppendsUser(): void {
+    $input = new ChatInput([
+      new ChatMessage('user', 'Hello.'),
+      new ChatMessage('system', 'Be concise.'),
+    ]);
+
+    $this->ensureConversationEndsWithUser($input);
+
+    $messages = $input->getMessages();
+    $this->assertCount(3, $messages);
+    $last = end($messages);
+    $this->assertSame('user', $last->getRole());
+    $this->assertSame('Continue.', $last->getText());
+  }
+
+  /**
+   * Tests that a conversation already ending with a user is left unchanged.
+   *
+   * @covers ::ensureConversationEndsWithUser
+   */
+  public function testTrailingUserMessageIsUnchanged(): void {
+    $input = new ChatInput([
+      new ChatMessage('assistant', 'Hi there.'),
+      new ChatMessage('user', 'Hello.'),
+    ]);
+
+    $this->ensureConversationEndsWithUser($input);
+
+    $messages = $input->getMessages();
+    $this->assertCount(2, $messages);
+    $last = end($messages);
+    $this->assertSame('user', $last->getRole());
+    $this->assertSame('Hello.', $last->getText());
+  }
+
+}
