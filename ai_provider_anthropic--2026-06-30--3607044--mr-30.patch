+use Drupal\ai\OperationType\Chat\ChatInput;
+use Drupal\ai\OperationType\Chat\ChatMessage;
+use Drupal\ai\OperationType\Chat\ChatOutput;
 use Drupal\ai\Traits\OperationType\ChatTrait;
 
 /**
@@ -22,6 +25,35 @@ class AnthropicProvider extends OpenAiBasedProviderClientBase {
 
   use ChatTrait;
 
+  /**
+   * {@inheritdoc}
+   */
+  public function chat(array|string|ChatInput $input, string $model_id, array $tags = []): ChatOutput {
+    if ($input instanceof ChatInput) {
+      $this->ensureConversationEndsWithUser($input);
+    }
+    return parent::chat($input, $model_id, $tags);
+  }
+
+  /**
+   * Ensures the chat conversation ends with a user message.
+   *
+   * Anthropic rejects a conversation whose last message is not from the user,
+   * which the AI Agents handoff can produce (a trailing assistant or system
+   * message), so we append a minimal trailing user message.
+   *
+   * @param \Drupal\ai\OperationType\Chat\ChatInput $input
+   *   The chat input to normalize in place.
+   */
+  protected function ensureConversationEndsWithUser(ChatInput $input): void {
+    $messages = $input->getMessages();
+    $last = end($messages);
+    if ($last instanceof ChatMessage && $last->getRole() !== 'user') {
+      $messages[] = new ChatMessage('user', 'Continue.');
+      $input->setMessages($messages);
+    }
+  }
+
   /**
    * {@inheritdoc}
    */
diff --git a/tests/src/Unit/AnthropicProviderChatTest.php b/tests/src/Unit/AnthropicProviderChatTest.php
