+    }
+    // A prop may constrain itself to a curated set of icons with `enum`. Keep
+    // that constraint: offer only those icons in the picker, and store the
+    // value in the form the schema declares, so the picked value still
+    // validates against the enum.
+    $enum = $schema['enum'] ?? NULL;
+    if (is_array($enum) && $enum !== []) {
+      $instance_settings['allowed_icon_ids'] = array_values(array_filter($enum, 'is_string'));
+    }
+    if ($instance_settings !== []) {
+      $storable_prop_shape->fieldInstanceSettings = $instance_settings;
