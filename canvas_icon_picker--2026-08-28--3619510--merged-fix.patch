     self::assertSame('canvas_icon_picker', $candidate->fieldWidget);
-    self::assertStringContainsString('string', (string) $candidate->fieldTypeProp, 'The field type must stay core string.');
+    self::assertSame('string', $candidate->fieldTypeProp->getFieldType(), 'The field type must stay core string.');
   }
 
   /**
@@ -86,4 +86,36 @@ final class PropShapeAlterTest extends KernelTestBase {
     self::assertNotSame('canvas_icon_picker', $this->candidate(['type' => 'string', 'x-canvas-icon' => []])->fieldWidget);
   }
 
+  /**
+   * Tests that an enum-constrained prop still gets the picker on a string.
+   *
+   * Canvas maps `enum` to list_string + options_select first; the picker widget
+   * only handles `string`, so the alter must swap the field type too or the
+   * widget is silently dropped.
+   */
+  public function testEnumPropGetsThePickerOnStringField(): void {
+    $candidate = $this->candidate(['type' => 'string', 'enum' => ['sun', 'umbrella'], 'x-canvas-icon' => TRUE]);
+    self::assertSame('canvas_icon_picker', $candidate->fieldWidget);
+    self::assertSame('string', $candidate->fieldTypeProp->getFieldType());
+    self::assertNull($candidate->fieldStorageSettings, 'list_string allowed_values_function must not leak onto the string field.');
+    self::assertSame(['allowed_icon_ids' => ['sun', 'umbrella']], $candidate->fieldInstanceSettings);
+  }
+
+  /**
+   * Tests that enum and pack scoping combine into one instance-settings array.
+   */
+  public function testEnumAndPackScopingCombine(): void {
+    $candidate = $this->candidate(['type' => 'string', 'enum' => ['sun'], 'x-canvas-icon' => ['test_pack']]);
+    self::assertSame(['allowed_icon_pack' => ['test_pack'], 'allowed_icon_ids' => ['sun']], $candidate->fieldInstanceSettings);
+  }
+
+  /**
+   * Tests that an enum without the opt-in keeps Canvas's select list.
+   */
+  public function testEnumWithoutOptInKeepsTheSelectList(): void {
+    $candidate = $this->candidate(['type' => 'string', 'enum' => ['sun', 'umbrella']]);
+    self::assertSame('options_select', $candidate->fieldWidget);
+    self::assertSame('list_string', $candidate->fieldTypeProp->getFieldType());
+  }
+
 }
