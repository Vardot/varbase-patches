diff --git a/tests/src/Kernel/IconIdScopingTest.php b/tests/src/Kernel/IconIdScopingTest.php
new file mode 100644
index 0000000000000000000000000000000000000000..b6474e68c58af93faa37c90a7220a082c42a3afe
--- /dev/null
+++ b/tests/src/Kernel/IconIdScopingTest.php
@@ -0,0 +1,142 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\canvas_icon_picker\Kernel;
+
+use Drupal\canvas_icon_picker\Controller\IconIndexController;
+use Drupal\canvas_icon_picker\Controller\IconSpriteController;
+use Drupal\KernelTests\KernelTestBase;
+use Symfony\Component\HttpFoundation\Request;
+
+/**
+ * Tests per-prop icon id scoping, driven by a prop schema `enum`.
+ *
+ * @group canvas_icon_picker
+ */
+final class IconIdScopingTest extends KernelTestBase {
+
+  /**
+   * Modules to enable.
+   *
+   * @var array<int, string>
+   */
+  protected static $modules = ['system', 'user', 'canvas_icon_picker_test', 'canvas_icon_picker'];
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+    $this->installConfig(['canvas_icon_picker']);
+  }
+
+  /**
+   * Tests that the index narrows to bare ids across every pack.
+   */
+  public function testIndexNarrowsToRequestedBareIds(): void {
+    $controller = IconIndexController::create($this->container);
+    $data = json_decode($controller->index(new Request(['ids' => 'star,cloud']))->getContent(), TRUE);
+    self::assertSame([['test_pack:star', 'Star'], ['test_pack_two:cloud', 'Cloud']], $data['icons']);
+    self::assertSame(['test_pack', 'test_pack_two'], array_column($data['packs'], 0));
+  }
+
+  /**
+   * Tests that a full "pack:icon" id is honoured as-is.
+   */
+  public function testIndexAcceptsFullIds(): void {
+    $controller = IconIndexController::create($this->container);
+    $data = json_decode($controller->index(new Request(['ids' => 'test_pack:heart']))->getContent(), TRUE);
+    self::assertSame([['test_pack:heart', 'Heart']], $data['icons']);
+  }
+
+  /**
+   * Tests that ids compose with packs instead of replacing them.
+   */
+  public function testIdsIntersectWithRequestedPacks(): void {
+    $controller = IconIndexController::create($this->container);
+    $data = json_decode($controller->index(new Request(['packs' => 'test_pack_two', 'ids' => 'star,cloud']))->getContent(), TRUE);
+    self::assertSame([['test_pack_two:cloud', 'Cloud']], $data['icons']);
+  }
+
+  /**
+   * Tests that an id matching nothing yields an empty grid, not everything.
+   */
+  public function testUnknownIdsYieldNoIcons(): void {
+    $controller = IconIndexController::create($this->container);
+    $data = json_decode($controller->index(new Request(['ids' => 'nope']))->getContent(), TRUE);
+    self::assertSame([], $data['icons']);
+    self::assertSame([], $data['packs']);
+  }
+
+  /**
+   * Tests that the sprite narrows to the same ids as the index.
+   */
+  public function testSpriteNarrowsToRequestedIds(): void {
+    $controller = IconSpriteController::create($this->container);
+    $body = $controller->sprite(new Request(['ids' => 'star']))->getContent();
+    self::assertStringContainsString('<symbol id="test_pack:star"', $body);
+    self::assertSame(1, substr_count($body, '<symbol'));
+  }
+
+  /**
+   * Tests that both endpoints vary their cache on the ids query argument.
+   */
+  public function testEndpointsVaryCacheOnIdsQueryArg(): void {
+    $index = IconIndexController::create($this->container)->index();
+    $sprite = IconSpriteController::create($this->container)->sprite();
+    self::assertContains('url.query_args:ids', $index->getCacheableMetadata()->getCacheContexts());
+    self::assertContains('url.query_args:ids', $sprite->getCacheableMetadata()->getCacheContexts());
+  }
+
+  /**
+   * Tests that the element forwards allowed ids to both endpoint URLs.
+   */
+  public function testElementForwardsAllowedIdsToEndpointUrls(): void {
+    $element = [
+      '#type' => 'canvas_icon_picker',
+      '#name' => 'icon',
+      '#allowed_packs' => ['test_pack'],
+      '#allowed_icon_ids' => ['star', 'heart'],
+    ];
+    $html = (string) $this->container->get('renderer')->renderInIsolation($element);
+    // cspell:disable-next-line
+    self::assertStringContainsString('data-canvas-icon-picker-index-url="/canvas-icon-picker/index?packs=test_pack&amp;ids=star%2Cheart"', $html);
+    // cspell:disable-next-line
+    self::assertStringContainsString('data-canvas-icon-picker-sprite-url="/canvas-icon-picker/sprite?packs=test_pack&amp;ids=star%2Cheart"', $html);
+  }
+
+  /**
+   * Tests that the element hands the allowed ids to the JS.
+   *
+   * The JS stores the value in the form the enum expects, because Canvas
+   * validates the input client-side before anything reaches the server.
+   */
+  public function testElementExposesAllowedIdsToJs(): void {
+    $element = [
+      '#type' => 'canvas_icon_picker',
+      '#name' => 'icon',
+      '#allowed_icon_ids' => ['star', 'heart'],
+    ];
+    $html = (string) $this->container->get('renderer')->renderInIsolation($element);
+    self::assertStringContainsString('data-canvas-icon-picker-allowed-ids="star,heart"', $html);
+  }
+
+  /**
+   * Tests that a bare id on a pack-scoped prop resolves in that pack first.
+   */
+  public function testBareIdResolvesAgainstPropPacksFirst(): void {
+    $element = [
+      '#type' => 'canvas_icon_picker',
+      '#name' => 'icon',
+      '#default_value' => 'cloud',
+      '#allowed_packs' => ['test_pack_two'],
+    ];
+    $html = (string) $this->container->get('renderer')->renderInIsolation($element);
+    self::assertStringContainsString('Cloud', $html);
+    $repository = $this->container->get('canvas_icon_picker.repository');
+    self::assertSame('test_pack_two', $repository->resolve('cloud', ['test_pack_two'])?->getPackId());
+    self::assertSame('test_pack', $repository->resolve('star', ['test_pack_two'])?->getPackId(), 'Falls back to the site-wide pack order.');
+  }
+
+}
diff --git a/tests/src/Kernel/PropShapeAlterTest.php b/tests/src/Kernel/PropShapeAlterTest.php
index 85756220558efd0886df771acf43d1fc50610016..ff7c6aff8661c46c0d1ef81da12186b3b5d73b90 100644
