diff --git a/src/Controller/ResolvesRequestedPacksTrait.php b/src/Controller/ResolvesRequestedPacksTrait.php
index 8b6f3424f87a838d98435511a9c0ae1fdd67eec0..4b14522b1fd673196bb8d1a4eb99596de4195f7d 100644
--- a/src/Controller/ResolvesRequestedPacksTrait.php
+++ b/src/Controller/ResolvesRequestedPacksTrait.php
@@ -25,4 +25,23 @@ trait ResolvesRequestedPacksTrait {
     return $allowed !== [] ? $allowed : ['__canvas_icon_picker_no_match__'];
   }
 
+  /**
+   * Bare icon ids a request restricts itself to; empty means unrestricted.
+   */
+  private function resolveRequestedIconIds(Request $request): array {
+    $requested = array_filter(explode(',', (string) $request->query->get('ids', '')));
+    return array_values(array_unique(array_map('trim', $requested)));
+  }
+
+  /**
+   * Whether a full "pack:icon_id" passes the requested id restriction.
+   */
+  private function iconIdIsAllowed(string $full_id, array $allowed_icon_ids): bool {
+    if ($allowed_icon_ids === []) {
+      return TRUE;
+    }
+    $bare_id = str_contains($full_id, ':') ? substr($full_id, strpos($full_id, ':') + 1) : $full_id;
+    return in_array($bare_id, $allowed_icon_ids, TRUE) || in_array($full_id, $allowed_icon_ids, TRUE);
+  }
+
 }
